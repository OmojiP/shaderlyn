<Project>

  <!--
    Visual Studio 拡張のビルド設定。

    リポジトリの直下の Directory.Build.props (ライブラリ向け) は読み込まない。
    拡張は Visual Studio が動かす .NET 8 の上で動き、Native AOT にもしないので、
    net10.0・IsAotCompatible・InvariantGlobalization を当てはめられない。
    バージョンだけは CLI・VS Code 拡張と同じものにする (リリースでは -p:Version で渡す)。
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>0.3.4</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
