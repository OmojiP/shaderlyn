<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shaderlyn.Core\Shaderlyn.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Shaderlyn の C 系のシェーダー言語 (HLSL / GLSL / Slang など) に共通の部分。字句解析、トークン、プリプロセッサ、取り込みの解決と使い回し。</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shaderlyn.Hlsl" />
    <InternalsVisibleTo Include="Shaderlyn.Glsl" />
    <InternalsVisibleTo Include="Shaderlyn.Semantics" />
    <InternalsVisibleTo Include="Shaderlyn.Unity" />
    <InternalsVisibleTo Include="Shaderlyn.Unreal" />
    <InternalsVisibleTo Include="Shaderlyn.Rules" />
    <InternalsVisibleTo Include="Shaderlyn.Testing" />
    <InternalsVisibleTo Include="Shaderlyn.Cli" />
    <InternalsVisibleTo Include="Shaderlyn.LanguageServer" />
  </ItemGroup>

</Project>
