<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shaderlyn.Core\Shaderlyn.Core.csproj" />
    <ProjectReference Include="..\Shaderlyn.Hlsl\Shaderlyn.Hlsl.csproj" />
    <ProjectReference Include="..\Shaderlyn.Glsl\Shaderlyn.Glsl.csproj" />
    <ProjectReference Include="..\Shaderlyn.Godot\Shaderlyn.Godot.csproj" />
    <ProjectReference Include="..\Shaderlyn.Slang\Shaderlyn.Slang.csproj" />
    <ProjectReference Include="..\Shaderlyn.Wgsl\Shaderlyn.Wgsl.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Shaderlyn のセマンティックモデル。自作ルールの基底クラス ShaderRuleAnalyzer を持つ。</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- GLSL の組み込みの関数と変数の表。tools/glsl/builtins.mjs が glslang から作る -->
  <ItemGroup>
    <EmbeddedResource Include="Symbols\GlslBuiltins.g.txt" LogicalName="Shaderlyn.Semantics.GlslBuiltins.txt" />
  </ItemGroup>

  <!-- Godot シェーダー言語の組み込みの変数と描画のモードの表。tools/godot/builtins.mjs が Godot のソースから作る -->
  <ItemGroup>
    <EmbeddedResource Include="Symbols\GodotBuiltins.g.txt" LogicalName="Shaderlyn.Semantics.GodotBuiltins.txt" />
  </ItemGroup>

  <!-- Slang の標準ライブラリの名前の表と、型の適合の表。tools/slang/stdlib.mjs が slang のソースの *.meta.slang から作る -->
  <ItemGroup>
    <EmbeddedResource Include="Symbols\SlangStdlib.g.txt" LogicalName="Shaderlyn.Semantics.SlangStdlib.txt" />
    <EmbeddedResource Include="Symbols\SlangConformance.g.txt" LogicalName="Shaderlyn.Semantics.SlangConformance.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shaderlyn.Rules" />
    <InternalsVisibleTo Include="Shaderlyn.Testing" />
    <InternalsVisibleTo Include="Shaderlyn.Cli" />
    <InternalsVisibleTo Include="Shaderlyn.LanguageServer" />
    <InternalsVisibleTo Include="Shaderlyn.Unity" />
  </ItemGroup>

</Project>
