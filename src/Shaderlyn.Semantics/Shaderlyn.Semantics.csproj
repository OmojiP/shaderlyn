<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shaderlyn.Core\Shaderlyn.Core.csproj" />
    <ProjectReference Include="..\Shaderlyn.Hlsl\Shaderlyn.Hlsl.csproj" />
    <ProjectReference Include="..\Shaderlyn.Glsl\Shaderlyn.Glsl.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Shaderlyn のセマンティックモデル。自作ルールの基底クラス ShaderRuleAnalyzer を持つ。</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- GLSL の組み込みの関数と変数の表。tools/glsl/builtins.mjs が glslang から作る -->
  <ItemGroup>
    <EmbeddedResource Include="Symbols\GlslBuiltins.g.txt" LogicalName="Shaderlyn.Semantics.GlslBuiltins.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shaderlyn.Rules" />
    <InternalsVisibleTo Include="Shaderlyn.Testing" />
    <InternalsVisibleTo Include="Shaderlyn.Cli" />
    <InternalsVisibleTo Include="Shaderlyn.LanguageServer" />
    <InternalsVisibleTo Include="Shaderlyn.Unity" />
  </ItemGroup>

</Project>
