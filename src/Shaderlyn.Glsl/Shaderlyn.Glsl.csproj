<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shaderlyn.Core\Shaderlyn.Core.csproj" />
    <ProjectReference Include="..\Shaderlyn.CFamily\Shaderlyn.CFamily.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Description>Shaderlyn の GLSL の方言 (構文解析)。</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 単位 P2 の試作。型を公開するか・パッケージにするかは GL1 で決める。それまでは配らない -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- パッケージにしないので、src/Directory.Build.props の指定 (パッケージにするものだけ) が掛からない -->
  <ItemGroup>
    <InternalsVisibleTo Include="Shaderlyn.Tests" />
  </ItemGroup>

</Project>
