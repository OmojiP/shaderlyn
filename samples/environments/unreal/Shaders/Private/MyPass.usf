// 動作確認用のシェーダー。意図的に誤りを入れてある (samples/environments/README.md)。
#include "/Engine/Private/Common.ush"
#include "/Plugin/MyPlugin/Private/PluginCommon.ush"

float4 MainPS(float4 SvPosition : SV_Position) : SV_Target0
{
#if PERMUTATION_HIGH_QUALITY
    float3 color = Tint(Square(SvPosition.x));
#else
    float4 color = Square(SvPosition.x);
#endif

#if PERMUTATION_SAMPLES > 1
    color *= 0.5;
#endif

    // View は生成されるファイルで宣言される uniform buffer。宣言が無いとは報告しない
    // 誤り (CF0312): PERMUTATION_HIGH_QUALITY == 1 のとき color は float3 なので .a は無い
    return color.a * View.PreExposure;
}
